{
  "name": "churchtools-mcp",
  "version": "0.1.1",
  "description": "MCP server for the ChurchTools API — runs locally over stdio (npx) or as a Streamable HTTP service. Fork of samuelspagl/ct-mcp with a stdio entrypoint.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "churchtools-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx watch src/stdio.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "churchtools",
    "mcp",
    "model-context-protocol",
    "stdio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@churchtools/churchtools-client": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "axios": "^1.9.0",
    "axios-cookiejar-support": "^6.0.2",
    "express": "^4.21.2",
    "tough-cookie": "^5.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
