# --- Local stdio usage (npx) ---
# Minimal config: only these two are required when running over stdio
# (e.g. spawned by Claude Desktop). stdio forces pat mode and needs no MCP token.
CHURCHTOOLS_BASE_URL=https://example.church.tools
CHURCHTOOLS_PAT=replace-with-login-token

# Optional (defaults shown):
# CHURCHTOOLS_OPENAPI_URL=https://example.church.tools/system/runtime/swagger/openapi.json
# REQUEST_TIMEOUT_MS=30000
# MAX_RESPONSE_BYTES=100000

# --- HTTP server only (ignored in stdio mode) ---
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
# CHURCHTOOLS_AUTH_MODE=pat                 # pat | pat-forwarding
# MCP_SERVER_TOKEN=replace-with-mcp-token   # bearer token required by POST /mcp
# ALLOW_UNAUTHENTICATED_MCP=false
#
# PAT forwarding mode: send each user's PAT as X-ChurchTools-PAT on every MCP request.
# CHURCHTOOLS_AUTH_MODE=pat-forwarding
